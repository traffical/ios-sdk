// Traffical sample app — local credentials template.
//
// Copy this file to `Secrets.xcconfig` (which is git-ignored) and fill in the
// values from your Traffical dashboard, then attach it to the target's build
// configurations under Project → Info → Configurations.
//
// IMPORTANT: use a PUBLISHABLE key (prefix `traffical_pk_`) in a client app.
// Never put a secret `traffical_sk_` key here or in any shipped client — secret
// keys must stay server-side only.

TRAFFICAL_ORG_ID = org_YOUR_ORG_ID
TRAFFICAL_PROJECT_ID = proj_YOUR_PROJECT_ID
TRAFFICAL_ENV = production
TRAFFICAL_API_KEY = traffical_pk_YOUR_PUBLISHABLE_KEY
